{
  "name": "room-tone-soundboard",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual local-network soundboard that plays audio through the host computer.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check public/script.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.4.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
